<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011"
     type="dynamic"
     availabilityStartTime="2026-07-17T00:00:00Z"
     minimumUpdatePeriod="PT1S"
     timeShiftBufferDepth="PT30S">
  <BaseURL availabilityTimeOffset="0.5" availabilityTimeComplete="true">live/</BaseURL>
  <ServiceDescription id="global-live">
    <Latency referenceId="encoder" min="1500" target="2000" max="3500" />
    <PlaybackRate min="0.95" max="1.05" />
  </ServiceDescription>
  <Period id="live" start="PT0S">
    <ServiceDescription id="period-live">
      <Latency referenceId="encoder" min="1000" target="1800" max="3000" />
    </ServiceDescription>
    <AdaptationSet id="video" contentType="video" mimeType="video/mp4" codecs="avc1.640028">
      <ProducerReferenceTime id="encoder" inband="true" presentationTime="900000"
                             wallClockTime="2026-07-17T00:00:10Z" />
      <SegmentTemplate timescale="90000" duration="180000" startNumber="1"
                       initialization="init-$RepresentationID$.mp4"
                       media="chunk-$Number$.m4s"
                       availabilityTimeOffset="1.5"
                       availabilityTimeComplete="false" />
      <Representation id="1080p" bandwidth="5000000" width="1920" height="1080">
        <ProducerReferenceTime id="encoder-latest" presentationTime="1080000"
                               wallClockTime="2026-07-17T00:00:12Z" />
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
